{
  "info": {
    "_postman_id": "9a5f29d5-30b8-4680-b3f5-0d4b14669cb7",
    "name": "teste_caixa_cinza API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
